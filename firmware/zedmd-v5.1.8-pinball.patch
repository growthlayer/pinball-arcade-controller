diff --git a/src/displays/LEDMatrix.cpp b/src/displays/LEDMatrix.cpp
index 2849f38..7b12552 100644
--- a/src/displays/LEDMatrix.cpp
+++ b/src/displays/LEDMatrix.cpp
@@ -49,13 +49,24 @@ uint8_t LedMatrix::GetCurrentScalingMode() { return 0; }
 
 void LedMatrix::SetCurrentScalingMode(uint8_t mode) {}
 
+// ZEDMD_ROTATE_180 (pinball-controller, 2026-10-03): the panels are mounted turned 180 deg so the chain input
+// sits next to the ESP32; every pixel goes through these two functions, so turning the picture here turns
+// everything - games, logo, menus.
+#ifdef ZEDMD_ROTATE_180
+#define ZX(x) (TOTAL_WIDTH - 1 - (x))
+#define ZY(y) (TOTAL_HEIGHT - 1 - (y))
+#else
+#define ZX(x) (x)
+#define ZY(y) (y)
+#endif
+
 void LedMatrix::DrawPixel(uint16_t x, uint16_t y, uint8_t r, uint8_t g,
                           uint8_t b) {
-  dma_display->drawPixelRGB888(x, y + yOffset, r, g, b);
+  dma_display->drawPixelRGB888(ZX(x), ZY(y) + yOffset, r, g, b);
 }
 
 void LedMatrix::DrawPixel(uint16_t x, uint16_t y, uint16_t color) {
-  dma_display->drawPixel(x, y + yOffset, color);
+  dma_display->drawPixel(ZX(x), ZY(y) + yOffset, color);
 }
 
 void LedMatrix::ClearScreen() { dma_display->clearScreen(); }
