--- a/src/main.cpp
+++ b/src/main.cpp
@@ -166,6 +166,32 @@ bool logoActive;
 bool transportActive;
 uint8_t transportWaitCounter;
 uint8_t logoWaitCounter;
+
+// ZEDMD_ATTRACT (pinball-controller, 2026-10-03): when the PC sends nothing, play a built-in attract loop
+// (orange DMD style, 30 fps) instead of going blank. Stops on the first frame from the PC.
+bool attractActive = false;
+#if defined(ZEDMD_ATTRACT) && (TOTAL_WIDTH == 128) && (TOTAL_HEIGHT == 32)
+// OFFLINE show: pre-rendered neon synthwave scenes that say the PC is not connected (NO SIGNAL, WAITING FOR PC,
+// PC OFFLINE, NO INPUT) - firmware/attract_offline.h, generated by tools/synthwave/make_offline_firmware.py.
+#include "attract_offline.h"
+static uint8_t attractFrame[TOTAL_WIDTH * TOTAL_HEIGHT * 3];
+void StartAttract() {
+  attractActive = true;
+  FxRestart();
+}
+void AttractStep() {
+  const uint32_t t0 = millis();
+  FxRender(attractFrame);
+  for (uint16_t y = 0; y < TOTAL_HEIGHT; y++)
+    for (uint16_t x = 0; x < TOTAL_WIDTH; x++) {
+      const uint8_t* p = attractFrame + (y * TOTAL_WIDTH + x) * 3;
+      display->DrawPixel(x, y, p[0], p[1], p[2]);
+    }
+  const uint32_t dt = millis() - t0;
+  vTaskDelay(pdMS_TO_TICKS(dt < 32 ? 33 - dt : 1));
+}
+#define HAVE_ATTRACT 1
+#endif
 uint32_t lastDataReceived;
 bool serverRunning;
 uint8_t throbberColors[6] __attribute__((aligned(4))) = {0};
@@ -611,6 +637,7 @@ void DisplayLogo(void) {
 
   logoActive = true;
   logoWaitCounter = 0;
+  attractActive = false;
 }
 
 void DisplayId() {
@@ -2200,12 +2227,20 @@ void loop() {
 
     if (logoWaitCounter < 201) ++logoWaitCounter;
 
+#ifdef HAVE_ATTRACT
+    if (!attractActive && (100 == logoWaitCounter || 200 == logoWaitCounter)) StartAttract();
+    if (attractActive) {
+      AttractStep();
+      return;
+    }
+#else
     if (100 == logoWaitCounter) {
       DisplayUpdate();
     }
     if (200 == logoWaitCounter) {
       ScreenSaver();
     }
+#endif
 
     display->DrawPixel(TOTAL_WIDTH - 3, TOTAL_HEIGHT - 3, throbberColors[0],
                        throbberColors[1], throbberColors[2]);
